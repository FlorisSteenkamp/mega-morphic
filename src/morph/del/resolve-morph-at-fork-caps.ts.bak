import type { MorphEntry } from './morph-entry.js';
import type { SleeveSide } from './anchored-sleeves.js';
import { getShapeArea } from 'flo-boolean';
import { getDiskChainEnvelope } from './get-disk-chain-envelope.js';
import { getLastP } from './fs/get-last-p.js';
import { reverseShapeOrientation } from 'flo-boolean';
import { pAtIndex } from './fs/p-at-idx.js';
import { boundaryTangents, boundaryPoint } from './anchored-sleeves.js';
import {
    intrinsicSkeletonLerp, wrapAngle, unwrappedChordAngles
} from './intrinsic-skeleton.js';

const { atan2, max, cos, sin, abs, ceil, hypot, PI: π } = Math;

const MIN_LEN = 1e-6;


interface ResolvedMorph {
    /** per entry: its drawn (lerped + glued) beziers */
    readonly drawn: number[][][][];
    /** per entry: its lerped boundary radii (undefined if entry has none) */
    readonly radii: (number[] | undefined)[];
    readonly outlines: number[][][][];
}


/**
 * Resolves every morph entry at `t` ∈ [0,1]: control points lerped, glue
 * applied (junctions riding their parents' drawn skeletons), radii lerped,
 * and the outline built by lerping the entry's original boundary sleeves
 * (disk envelope as fallback), all as loops ready for a winding-number union.
 */
function resolveMorphAt(
        entries: MorphEntry[],
        t: number): ResolvedMorph {

    // Drawn (post-glue) beziers per entry; parents resolved on demand.
    const drawn: (number[][][] | undefined)[] = entries.map(() => undefined);
    // Continuous first-segment anchor angle per entry (no atan2 re-wrapping).
    const alphas: number[] = entries.map(() => 0);

    const getDrawn_ = getDrawn(t, entries, drawn, alphas);

    const radii: (number[] | undefined)[] = [];
    const outlines: number[][][][] = [];
    for (let i = 0; i < entries.length; i++) {
        const { ra, rb } = entries[i];
        if (ra === undefined || rb === undefined) {
            radii.push(undefined);
            getDrawn_(i);
            continue;
        }

        const rs = ra.map((r, k) => r*(1 - t) + rb[k]*t);
        radii.push(rs);

        // Boundary anchored to the drawn maximal disks, shape lerped on top;
        // bare disk envelope as fallback.
        const loops = [
            sleeveOutline(entries[i], getDrawn_(i), rs, t),
            // getDiskChainEnvelope(getDrawn_(i), rs)
        ];

        for (const loop of loops) {
            if (loop === undefined) { continue; }

            // The union is winding-number based - orient all loops alike.
            outlines.push(getShapeArea(loop) < 0
                ? reverseShapeOrientation(loop)
                : loop
            );
        }
    }

    return {
        drawn: drawn as number[][][][],
        radii,
        outlines
    };
}


/**
 * The morphed outline of one entry: per skeleton segment, both frames'
 * boundary anchors rebuilt in the DRAWN disks' local frames (so they ride
 * the interpolated maximal disks) and interpolated; the boundary pieces
 * between them lerped in their chord frames and mapped through the
 * interpolated chords; the two sides closed with disk cap arcs at the tips
 * (fork/tip gaps bridged with line segments - the loop union covers those).
 */
function sleeveOutline(
        entry: MorphEntry,
        bz: number[][][],
        rs: number[],
        t: number): number[][][] | undefined {

    const { sleeveOut, sleeveBack, capSign = 1 } = entry;
    if (sleeveOut === undefined || sleeveBack === undefined) {
        return undefined;
    }
    if (sleeveOut.piecesA.length === 0) { return undefined; }

    const Ts = boundaryTangents(bz);

    const out = reconstructSide(sleeveOut, true, bz, rs, Ts, capSign, t);
    const back = reconstructSide(sleeveBack, false, bz, rs, Ts, capSign, t);

    const pStart = bz[0][0];
    const pEnd = getLastP(bz);

    // out runs tip → end, back runs end → tip (outline direction).
    // A glued entry closes through its JUNCTION (= pEnd, glued onto the
    // parent's skeleton, strictly interior to the parent's region) - the
    // wedge guarantees overlap with the parent at every t, and at t=0/1 its
    // extra sliver is covered by the parent's fork-gap arc.
    const endCap = entry.glue !== undefined
        ? [pEnd]
        : capArcPts(pEnd, rs[rs.length - 1], out.last, back.first, capSign);
    const startCap = capArcPts(
        pStart, rs[0], back.last, out.first, capSign);

    return assembleLoop([
        ...out.pieces,
        ...endCap.map(p => [p]),
        ...back.pieces,
        ...startCap.map(p => [p]),
    ]);
}


/**
 * One side's boundary pieces at time `t`, in outline order: anchors
 * interpolated in the drawn disks' local frames, chord-normalized pieces
 * lerped and mapped through the interpolated anchor chords. Fork gaps
 * (skipped child sectors) are bridged with the fork disk's arc, swept with
 * the winding - the parent's true region boundary there.
 */
function reconstructSide(
        side: SleeveSide,
        isOut: boolean,
        bz: number[][][],
        rs: number[],
        Ts: number[][],
        capSign: number,
        t: number): { pieces: number[][][]; first: number[]; last: number[] } {

    const n = side.piecesA.length;
    const pieces: number[][][] = [];
    let first: number[] = [0, 0];
    let last: number[] = [0, 0];

    for (let m = 0; m < n; m++) {
        const k = isOut ? m : n - 1 - m;  // outline order
        const aA = side.anchorsA[k];
        const aB = side.anchorsB[k];
        const bidxFrom = isOut ? k : k + 1;
        const bidxTo = isOut ? k + 1 : k;

        const e0 = anchorPoint(
            aA[0], aA[1], aB[0], aB[1], bidxFrom, bz, rs, Ts, t);
        const e1 = anchorPoint(
            aA[2], aA[3], aB[2], aB[3], bidxTo, bz, rs, Ts, t);

        if (m === 0) {
            first = e0;
        } else {
            // Fork gap: bridge along the boundary disk at this knot.
            const gap = hypot(e0[0] - last[0], e0[1] - last[1]);
            if (gap > 1e-3) {
                const p = boundaryPoint(bz, bidxFrom);
                pieces.push(...capArcPts(p, rs[bidxFrom], last, e0, capSign)
                    .map(q => [q]));
            }
        }
        last = e1;

        // Chord frame of the interpolated anchors (same degenerate rule as
        // normalization so t=0/1 reproduce the originals exactly).
        let bx = e1[0] - e0[0];
        let by = e1[1] - e0[1];
        if (bx*bx + by*by < MIN_LEN*MIN_LEN*1e-6) { bx = 1; by = 0; }

        const qsA = side.piecesA[k];
        const qsB = side.piecesB[k];
        for (let i = 0; i < qsA.length; i++) {
            pieces.push(qsA[i].map((q, j) => {
                const qx = q[0]*(1 - t) + qsB[i][j][0]*t;
                const qy = q[1]*(1 - t) + qsB[i][j][1]*t;
                return [
                    e0[0] + bx*qx - by*qy,
                    e0[1] + by*qx + bx*qy
                ];
            }));
        }
    }

    return { pieces, first, last };
}


/** The interpolated anchor: polar coords lerped (θ the short way) and applied
 *  to the DRAWN disk's local frame at skeleton boundary `bidx`. */
function anchorPoint(
        thA: number, rhA: number,
        thB: number, rhB: number,
        bidx: number,
        bz: number[][][],
        rs: number[],
        Ts: number[][],
        t: number): number[] {

    const dθ = ((thB - thA + π) % (2*π) + 2*π) % (2*π) - π;
    const θ = thA + t*dθ;
    const ρ = rhA*(1 - t) + rhB*t;

    const p = boundaryPoint(bz, bidx);
    const r = rs[bidx];
    const T = Ts[bidx];
    const N = [-T[1], T[0]];
    const ux = cos(θ)*T[0] + sin(θ)*N[0];
    const uy = cos(θ)*T[1] + sin(θ)*N[1];

    return [p[0] + ρ*r*ux, p[1] + ρ*r*uy];
}


/**
 * Chains ordered open pieces into one closed loop: consecutive pieces are
 * snapped together when their endpoints (nearly) coincide, else bridged with
 * a line segment; single-point pieces act as polyline waypoints.
 */
function assembleLoop(pieces: number[][][]): number[][][] | undefined {
    const loop: number[][][] = [];

    for (let ps of pieces) {
        const prev = loop[loop.length - 1];
        if (prev === undefined) {
            if (ps.length >= 2) { loop.push(ps); }
            continue;
        }

        const q = prev[prev.length - 1];
        const gap = hypot(ps[0][0] - q[0], ps[0][1] - q[1]);

        if (ps.length === 1) {  // waypoint
            if (gap > MIN_LEN) { loop.push([q, ps[0]]); }
            continue;
        }

        if (gap > MIN_LEN) {
            loop.push([q, ps[0]]);  // bridge
        } else {
            ps = [q, ...ps.slice(1)];  // snap for exact continuity
        }
        loop.push(ps);
    }

    if (loop.length < 2) { return undefined; }

    // Close the loop exactly.
    const first = loop[0][0];
    const last = getLastP(loop);
    const gap = hypot(first[0] - last[0], first[1] - last[1]);
    if (gap > MIN_LEN) {
        loop.push([last, first]);
    } else {
        const lastPs = loop[loop.length - 1];
        loop[loop.length - 1] = [...lastPs.slice(0, -1), first];
    }

    return loop;
}


/** Interior points of the arc of the disk at `p` from `from` to `to`,
 *  sweeping in the direction given by the outline winding `sign`. */
function capArcPts(
        p: number[],
        r: number,
        from: number[],
        to: number[],
        sign: number,
        capSteps = 16): number[][] {

    if (r < MIN_LEN) { return []; }

    const a0 = atan2(from[1] - p[1], from[0] - p[0]);
    const a1 = atan2(to[1] - p[1], to[0] - p[0]);

    const ccw = ((a1 - a0) % (2*π) + 2*π) % (2*π);
    const sweep = sign > 0 ? ccw : ccw - 2*π;

    const steps = max(2, ceil(capSteps * abs(sweep) / (2*π)));
    const out: number[][] = [];
    for (let k = 1; k < steps; k++) {
        const th = a0 + sweep * (k / steps);
        out.push([p[0] + r*cos(th), p[1] + r*sin(th)]);
    }
    return out;
}


/**
 * Returns a memoized resolver that computes an entry's drawn beziers at `t`:
 * skeleton interpolated intrinsically between frames `a` and `b`, then, if
 * the entry is glued, translated so its endpoint rides its parent's drawn
 * skeleton AND rotated about that junction by the parent's local frame
 * rotation there (beyond the naive angle lerp) - so the child's angle
 * RELATIVE to its parent interpolates linearly. All angles are tracked
 * UNWRAPPED and continuously in t (`alphas` carries each entry's continuous
 * anchor angle), so the rotation never jumps by 2π mid-morph. Parents are
 * resolved recursively on demand; results are cached in `drawn`.
 */
function getDrawn(
        t: number,
        entries: MorphEntry[],
        drawn: (number[][][] | undefined)[],
        alphas: number[]) {

    return getDrawn_;

    /** ψ at attachment `k` on the DRAWN parent `e`, continuous in t. */
    function parentPsi(e: number, k: number): number {
        const ψs = unwrappedChordAngles(getDrawn_(e));
        return alphas[e] + (profileAngleAt(ψs, k) - ψs[0]);
    }

    /** ψ at `k` on parent `e`'s static frame-a skeleton. */
    function staticPsiA(e: number, k: number): number {
        return profileAngleAt(unwrappedChordAngles(entries[e].a), k);
    }

    /** ψ at `k` on parent `e`'s static frame-b skeleton, re-anchored to the
     *  drawn parent's continuous anchor at t=1 (same value mod 2π). */
    function staticPsiB(e: number, k: number): number {
        const ψsA = unwrappedChordAngles(entries[e].a);
        const ψsB = unwrappedChordAngles(entries[e].b);
        const adj = ψsA[0] + wrapAngle(ψsB[0] - ψsA[0]) - ψsB[0];
        return profileAngleAt(ψsB, k) + adj;
    }

    function getDrawn_(i: number): number[][][] {
        const cached = drawn[i];
        if (cached !== undefined) { return cached; }

        const { a, b, glue } = entries[i];

        // Length + knot-angle interpolation (not a control-point lerp).
        let bz = intrinsicSkeletonLerp(a, b, t);

        // Continuous anchor angle (matches intrinsicSkeletonLerp's φ0(t)).
        const φ0A = unwrappedChordAngles(a)[0];
        const φ0B = unwrappedChordAngles(b)[0];
        let α = φ0A + t*wrapAngle(φ0B - φ0A);

        if (glue !== undefined) {
            let target: number[];
            let dψ: number;  // parent frame rotation beyond its naive lerp

            if (glue.e1 === glue.e2) {
                // Junction slides along the one parent from k1 to k2.
                const kf = (1 - t)*glue.k1 + t*glue.k2;
                target = pAtIndex(getDrawn_(glue.e1), kf);

                const ψ = parentPsi(glue.e1, kf);
                dψ = (1 - t)*(ψ - staticPsiA(glue.e1, glue.k1))
                    + t*(ψ - staticPsiB(glue.e1, glue.k2));
            } else {
                // Attached to different branches per frame: blend between
                // the two attachment points' drawn positions.
                const p1 = pAtIndex(getDrawn_(glue.e1), glue.k1);
                const p2 = pAtIndex(getDrawn_(glue.e2), glue.k2);
                target = [
                    (1 - t)*p1[0] + t*p2[0],
                    (1 - t)*p1[1] + t*p2[1]
                ];

                dψ = (1 - t)*(parentPsi(glue.e1, glue.k1)
                        - staticPsiA(glue.e1, glue.k1))
                    + t*(parentPsi(glue.e2, glue.k2)
                        - staticPsiB(glue.e2, glue.k2));
            }

            α += dψ;

            // Rotate about the junction by dψ, then move it onto the parent
            // (both vanish at t=0 and t=1).
            const base = getLastP(bz);
            const dx = target[0] - base[0];
            const dy = target[1] - base[1];
            const c = cos(dψ);
            const s = sin(dψ);
            bz = bz.map(ps => ps.map(p => {
                const ux = p[0] - base[0];
                const uy = p[1] - base[1];
                return [
                    base[0] + dx + c*ux - s*uy,
                    base[1] + dy + s*ux + c*uy
                ];
            }));
        }

        alphas[i] = α;
        drawn[i] = bz;
        return bz;
    }
}


/**
 * The angle profile's value at (fractional) boundary index `kf`, CONTINUOUS
 * in `kf`: unwrapped per-segment chord angles interpolated between segment
 * midpoints - so a sliding attachment never jumps across a sharp bend.
 */
function profileAngleAt(ψs: number[], kf: number): number {
    const n = ψs.length;
    if (n === 1) { return ψs[0]; }

    // Segment k's angle sits at index k + 0.5.
    const x = Math.min(Math.max(kf - 0.5, 0), n - 1);
    const k = Math.min(Math.floor(x), n - 2);
    const f = x - k;

    return ψs[k]*(1 - f) + ψs[k + 1]*f;
}


export { resolveMorphAt }
export type { ResolvedMorph }
